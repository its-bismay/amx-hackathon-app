# ==========================================
# AEGIS Platform — Root GitIgnore Configuration
# ==========================================

# ─── Documentation Files ───
# Ignore all markdown files except README.md
*.md
!README.md
!readme.md

# ─── Environment & Secrets ───
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# ─── Python Dependencies & Virtual Environments ───
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# ─── Database & Storage Files ───
*.sqlite
*.sqlite3
*.db
mock_bank.db
governance.db
ai_platform.db
*.log

# ─── Node.js & Frontend (Vite / React) ───
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
.pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
npm-debug.log*

# ─── Testing & Tooling Caches ───
.pytest_cache/
.coverage
htmlcov/
.inngest/

# ─── IDE & OS Files ───
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
