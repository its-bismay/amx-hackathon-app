PORT=8000
AI_PLATFORM_DATABASE_URL="postgresql://user:pass@ep-zzz-ai-platform.neon.tech/aiplatform?sslmode=require"
REDIS_URL="redis://localhost:6379"
SBF_URL="http://localhost:8001"
# ⚠️  Must match JWT_SECRET in secure-banking-fabric/.env — both services share the same token signing key
JWT_SECRET="sbf-agent-jwt-secret-key-change-in-prod"
# --- Inngest ---

# DEV: just set INNGEST_DEV=1. Keys are NOT required locally.
INNGEST_DEV=1
# PROD: remove INNGEST_DEV and set real keys from app.inngest.com
# INNGEST_EVENT_KEY="signkey-prod-..."
# INNGEST_SIGNING_KEY="signkey-prod-..."


# Gemini API Keys for Pool (comma-separated or KEY_1..KEY_4)
GEMINI_API_KEY_1="your-gemini-key-1"
GEMINI_API_KEY_2="your-gemini-key-2"
GEMINI_API_KEY_3="your-gemini-key-3"
GEMINI_API_KEY_4="your-gemini-key-4"
